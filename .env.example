# =============================================================================
# Sauga Artisan Festival — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all required values before running locally.
# NEVER commit .env to version control.
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── Database & Storage (Supabase) ────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=vendor-uploads

# ─── Admin Authentication (REQUIRED — no defaults, app refuses to start without these) ────
ADMIN_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=change-me-to-a-random-64-char-string

# ─── Email (optional — confirmation emails disabled if absent) ─────────────────
RESEND_API_KEY=
EMAIL_FROM="Sauga Artisan Festival <noreply@saugaartisanfest.ca>"
